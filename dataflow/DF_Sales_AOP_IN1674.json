{
	"name": "DF_Sales_AOP_IN1674",
	"properties": {
		"folder": {
			"name": "src_to_stg"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"name": "SRCstg"
				},
				{
					"name": "SRCtgt"
				}
			],
			"sinks": [
				{
					"name": "SNKtgt"
				}
			],
			"transformations": [
				{
					"name": "maxDate"
				},
				{
					"name": "Transformation"
				},
				{
					"name": "AlterInsert"
				},
				{
					"name": "Insert"
				},
				{
					"name": "AlterDelete"
				},
				{
					"name": "union1"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> SRCstg",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false) ~> SRCtgt",
				"SRCtgt aggregate() ~> maxDate",
				"SRCstg derive() ~> Transformation",
				"Insert@Insert alterRow() ~> AlterInsert",
				"Transformation split(ERROR_FUNCTION(''),",
				"     ERROR_FUNCTION(''),",
				"     disjoint: true) ~> Insert@(Insert, delete)",
				"Insert@delete alterRow() ~> AlterDelete",
				"AlterInsert, AlterDelete union(byName: true)~> union1",
				"union1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     format: 'table') ~> SNKtgt"
			]
		}
	}
}