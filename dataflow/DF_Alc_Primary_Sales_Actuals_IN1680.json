			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Azure_sql_IN1680",
						"type": "DatasetReference"
					},
					"name": "SNKstgActuals"
				}
			],
			"transformations": [
				{
					"name": "LeftCompany"
				},
				{
