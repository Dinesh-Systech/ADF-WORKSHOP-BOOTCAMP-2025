{
	"name": "DF_OrgTSE_IN1674",
	"properties": {
		"folder": {
			"name": "Final_Project/STG_TGT"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_AzureSqlTarget_IN1674",
						"type": "DatasetReference"
					},
					"name": "SRCSalesOrgTSE"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_AzureSqlTarget_IN1674",
						"type": "DatasetReference"
					},
					"name": "SNKAlcSalesOrgTSE",
					"rejectedDataLinkedService": {
						"referenceName": "LS_AzureBlobStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "SKSalesOrgTSE"
				},
				{
					"name": "NullHandling"
				},
				{
					"name": "select1"
				},
				{
					"name": "DataTypeConversion"
				}
			],
			"scriptLines": [
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SRCSalesOrgTSE",
				"NullHandling keyGenerate(output({TSE Key} as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> SKSalesOrgTSE",
				"DataTypeConversion derive(each(match(type=='integer'), $$ = iifNull($#,0)),",
				"          each(match(type=='string'), $$ = replace(iifNull($$,'UNK'),'null','UNK')),",
				"          each(match(type=='timestamp'), $$ = iifNull($$,toTimestamp('31/12/2999 00:00:00'))),",
				"          each(match(type=='date'), $$ = iifNull($$,toDate('31/12/2999'))),",
				"          UpdatedAt = currentDate()) ~> NullHandling",
				"SKSalesOrgTSE select(mapColumn(",
				"          {TSE Start Date},",
				"          {TSE End Date},",
				"          UpdatedAt,",
				"          {TSE Key}",
				"     ),",
				"     partitionBy('hash', 1),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"SRCSalesOrgTSE derive({TSE Start Date} = toDate({TSE Start Date},'dd-MM-yyyy'),",
				"          {TSE End Date} = toDate({TSE End Date},'dd-MM-yyyy')) ~> DataTypeConversion",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          {TSE Territory Name},",
				"          {TSE Territory Code},",
				"          {TSE Territory ID},",
				"          TSE,",
				"          {TSE Code},",
				"          {TSE SFA Code},",
				"          {TSE Email},",
				"          {TSE Mobile},",
				"          {TSE Call_Norm},",
				"          State,",
				"          State_Code,",
				"          DISTRICT,",
				"          DISTRICT_CODE,",
				"          {Active Flag},",
				"          {TSE Start Date},",
				"          {TSE End Date},",
				"          TL_Code,",
				"          CreatedAt,",
				"          CreatedBy,",
				"          UpdatedBy,",
				"          {TSE Key}",
				"     )) ~> SNKAlcSalesOrgTSE"
			]
		}
	}
}